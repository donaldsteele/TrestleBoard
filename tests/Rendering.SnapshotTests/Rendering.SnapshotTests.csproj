<Project Sdk="Microsoft.NET.Sdk">
  <!-- PNG snapshot tests vs committed Baselines/ start in M1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TrestleBoard.Rendering\TrestleBoard.Rendering.csproj" />
    <ProjectReference Include="..\..\src\TrestleBoard.Export.Pdf\TrestleBoard.Export.Pdf.csproj" />
    <!-- Rendering itself never references Widgets (it draws them through IWidgetLayoutProvider);
         the snapshots inject the real registry, which is also what proves the seam works. -->
    <ProjectReference Include="..\..\src\TrestleBoard.Widgets\TrestleBoard.Widgets.csproj" />
  </ItemGroup>
</Project>
