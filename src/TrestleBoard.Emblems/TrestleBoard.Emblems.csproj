<Project Sdk="Microsoft.NET.Sdk">
  <!-- The craft's emblems (PLAN.md §11 M65). A leaf, like Imaging and Roster: SkiaSharp and the
       BCL, never Core. An emblem is geometry and a name — it knows nothing about documents, and the
       App turns one into an ordinary picture through M18's single ingest path. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <!-- Gate 22, the fonts precedent: the provenance travels with the build, not only with the repo. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../assets-src/emblems/EMBLEMS-PROVENANCE.txt"
                      LogicalName="TrestleBoard.Emblems.EMBLEMS-PROVENANCE.txt" />
  </ItemGroup>
</Project>
