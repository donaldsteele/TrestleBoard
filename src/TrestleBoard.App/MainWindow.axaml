<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="using:TrestleBoard.App.Canvas"
        x:Class="TrestleBoard.App.MainWindow"
        Title="TrestleBoard"
        Width="1280" Height="860"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="TrestleBoard main window">
  <!-- Minimum 16pt UI text, every action keyboard-reachable (PLAN.md §6). Every menu item carries
       the action id it runs in Tag and shares one Click handler: availability, the plain-language
       reason it is unavailable, and the code that performs it all come from one place (M11). -->
  <DockPanel>
    <LayoutTransformControl x:Name="MenuScale" DockPanel.Dock="Top">
    <!-- The menu bar takes the same chrome as the toolbar under it. Fluent leaves a Menu
         transparent, which read as a white strip above a grey one in Light. -->
    <Menu FontSize="16" Background="{DynamicResource TrestleBoard.Chrome.Background}">
      <MenuItem Header="_File" AutomationProperties.Name="File menu">
        <MenuItem Header="_Open a newsletter…" Tag="newsletter.open"
                  InputGesture="Ctrl+O" Click="OnActionClicked"
                  AutomationProperties.Name="Open a newsletter" />
        <MenuItem Header="Open the _sample newsletter" Tag="newsletter.openSample"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Open the sample newsletter" />
        <Separator />
        <MenuItem Header="S_tart from a template…" Tag="newsletter.newFromTemplate"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Start from a template" />
        <MenuItem Header="Start from _last month" Tag="newsletter.startFromLastMonth"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Start this month from last month's newsletter" />
        <MenuItem Header="Whi_ch issue is this?…" Tag="newsletter.issueDate"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Say which month and year this newsletter is for" />
        <MenuItem Header="Newsletters yo_u had open…" Tag="newsletter.recent"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Newsletters you had open" />
        <MenuItem Header="What this newsletter is c_alled…" Tag="newsletter.about"
                  Click="OnActionClicked"
                  AutomationProperties.Name="What this newsletter is called" />
        <Separator />
        <MenuItem x:Name="SaveMenuItem" Header="S_ave this newsletter" Tag="newsletter.save"
                  InputGesture="Ctrl+S" Click="OnActionClicked"
                  AutomationProperties.Name="Save this newsletter" />
        <MenuItem Header="Save it as a ne_w file…" Tag="newsletter.saveAs"
                  InputGesture="Ctrl+Shift+S" Click="OnActionClicked"
                  AutomationProperties.Name="Save this newsletter as a new file" />
        <MenuItem Header="_Go back to an earlier version…" Tag="newsletter.restore"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Go back to an earlier version of this newsletter" />
        <MenuItem Header="_My templates" AutomationProperties.Name="My templates">
          <MenuItem Header="Save this as one of _my templates…" Tag="newsletter.saveAsTemplate"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Save this newsletter as one of my templates" />
          <MenuItem Header="My templ_ates…" Tag="newsletter.myTemplates"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Rename, remove or hand on my templates" />
        </MenuItem>
        <Separator />
        <!-- M101: four ways of checking the newsletter, which is one job done four ways and was four rows between Save and Make the PDF. -->
        <MenuItem Header="C_heck it over" AutomationProperties.Name="Check it over">
          <MenuItem Header="Loo_k it over with me…" Tag="newsletter.review"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Look the newsletter over with me" />
          <MenuItem Header="Check my spelli_ng…" Tag="newsletter.checkSpelling"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Check my spelling" />
          <MenuItem Header="Show me last _year's…" Tag="newsletter.lastYear"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Show me the same month from last year" />
          <MenuItem Header="_Read it back to me…" Tag="newsletter.readAloud"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Read the newsletter back to me" />
        </MenuItem>
        <MenuItem Header="Make the _PDF…" Tag="newsletter.exportPdf"
                  InputGesture="Ctrl+E" Click="OnActionClicked"
                  AutomationProperties.Name="Make the PDF to email" />
        <MenuItem Header="Make a _draft copy…" Tag="newsletter.exportDraft"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Make a draft copy for the Master to read" />
        <MenuItem Header="Sav_e a page to share…" Tag="newsletter.exportPicture"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Save a page to share as a picture" />
        <MenuItem Header="Pr_int it" Tag="newsletter.print"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Print the PDF you just made" />
        <MenuItem Header="_Now send it…" Tag="newsletter.send"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Send the newsletter to the brethren" />
        <Separator />
        <MenuItem Header="Handing ove_r" AutomationProperties.Name="Handing over">
          <MenuItem Header="Pack everything _up for my successor…" Tag="everything.packUp"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Pack everything up for my successor" />
          <MenuItem Header="_Bring in a predecessor's pack…" Tag="everything.bringInAPack"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Bring in a predecessor's pack" />
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" Tag="newsletter.exit" Click="OnActionClicked"
                  AutomationProperties.Name="Exit TrestleBoard" />
      </MenuItem>
      <MenuItem Header="_Edit" AutomationProperties.Name="Edit menu">
        <MenuItem x:Name="UndoMenuItem" Header="U_ndo" Tag="edit.undo"
                  InputGesture="Ctrl+Z" Click="OnActionClicked" AutomationProperties.Name="Undo" />
        <MenuItem x:Name="RedoMenuItem" Header="R_edo" Tag="edit.redo"
                  InputGesture="Ctrl+Y" Click="OnActionClicked" AutomationProperties.Name="Redo" />
        <Separator />
        <MenuItem Header="Cu_t" Tag="edit.cut" InputGesture="Ctrl+X"
                  Click="OnActionClicked" AutomationProperties.Name="Cut" />
        <MenuItem Header="_Copy" Tag="edit.copy" InputGesture="Ctrl+C"
                  Click="OnActionClicked" AutomationProperties.Name="Copy" />
        <MenuItem Header="_Paste" Tag="edit.paste" InputGesture="Ctrl+V"
                  Click="OnActionClicked" AutomationProperties.Name="Paste" />
        <Separator />
        <MenuItem Header="Select _all" Tag="edit.selectAll" InputGesture="Ctrl+A"
                  Click="OnActionClicked" AutomationProperties.Name="Select all" />
        <MenuItem Header="C_hoose everything on this page" Tag="edit.selectAllFrames"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Choose everything on this page" />
        <MenuItem Header="Also choose the ne_xt one" Tag="edit.alsoChooseNext"
                  InputGesture="Ctrl+Tab" Click="OnActionClicked"
                  AutomationProperties.Name="Also choose the next one" />
        <MenuItem Header="Also choose the one _before" Tag="edit.alsoChoosePrevious"
                  InputGesture="Ctrl+Shift+Tab" Click="OnActionClicked"
                  AutomationProperties.Name="Also choose the one before" />
        <Separator />
        <MenuItem Header="_Find…" Tag="edit.find" InputGesture="Ctrl+F"
                  Click="OnActionClicked" AutomationProperties.Name="Find words in this newsletter" />
        <MenuItem Header="F_ind and replace…" Tag="edit.replace" InputGesture="Ctrl+H"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Find words and replace them with different ones" />
        <Separator />
        <MenuItem Header="_Delete this" Tag="item.delete" InputGesture="Delete"
                  Click="OnActionClicked" AutomationProperties.Name="Delete this" />
        <MenuItem Header="Chan_ge what this says…" Tag="item.edit" InputGesture="Ctrl+Shift+E"
                  Click="OnActionClicked" AutomationProperties.Name="Change what this item says" />
        <MenuItem Header="Edit the _list…" Tag="item.editList" InputGesture="Ctrl+Shift+G"
                  Click="OnActionClicked" AutomationProperties.Name="Edit this list" />
      </MenuItem>
      <MenuItem Header="F_ormat" AutomationProperties.Name="Format menu">
        <MenuItem Header="_Bold" Tag="text.bold" InputGesture="Ctrl+B"
                  Click="OnActionClicked" AutomationProperties.Name="Bold" />
        <MenuItem Header="_Italic" Tag="text.italic" InputGesture="Ctrl+I"
                  Click="OnActionClicked" AutomationProperties.Name="Italic" />
        <!-- M102: M86's last deliverable, beside the two it belongs with. -->
        <MenuItem Header="_Underline" Tag="text.underline" InputGesture="Ctrl+U"
                  Click="OnActionClicked" AutomationProperties.Name="Underline" />
        <Separator />
        <MenuItem Header="Make this a list of poi_nts" Tag="text.bulletList"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Make this a list of points" />
        <MenuItem Header="Make this a numbe_red list" Tag="text.numberList"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Make this a numbered list" />
        <Separator />
        <MenuItem x:Name="ParagraphStyleMenu" Header="Paragraph _style" Tag="text.paragraphStyle"
                  AutomationProperties.Name="Paragraph style" />
        <!-- M96, regrouped by M101: three verbs that answer one question. -->
        <MenuItem Header="_Which way it lines up" AutomationProperties.Name="Which way it lines up">
          <MenuItem Header="On the _left" Tag="text.alignLeft" InputGesture="Ctrl+L"
                    Click="OnActionClicked" AutomationProperties.Name="Line it up on the left" />
          <MenuItem Header="Down the _middle" Tag="text.alignCentre" InputGesture="Ctrl+Shift+C"
                    Click="OnActionClicked" AutomationProperties.Name="Line it up down the middle" />
          <MenuItem Header="On the _right" Tag="text.alignRight" InputGesture="Ctrl+R"
                    Click="OnActionClicked" AutomationProperties.Name="Line it up on the right" />
        </MenuItem>
        <!-- M101: everything that changes the appearance of writing, in one place. Bold, italic and the two list verbs stay outside it because they are pressed far more often than everything here put together. -->
        <MenuItem Header="_How the writing looks" AutomationProperties.Name="How the writing looks">
          <MenuItem Header="What colour the writin_g is…" Tag="text.colour"
                    Click="OnActionClicked"
                    AutomationProperties.Name="What colour the writing is" />
          <MenuItem Header="_Make text bigger" Tag="text.bigger" InputGesture="Ctrl+Shift+OemPeriod"
                    Click="OnActionClicked" AutomationProperties.Name="Make text bigger" />
          <MenuItem Header="Mak_e text smaller" Tag="text.smaller" InputGesture="Ctrl+Shift+OemComma"
                    Click="OnActionClicked" AutomationProperties.Name="Make text smaller" />
          <MenuItem Header="How sp_aced out the writing is…" Tag="text.writingLook"
                    Click="OnActionClicked"
                    AutomationProperties.Name="How spaced out the writing is" />
          <MenuItem Header="Cop_y how this looks" Tag="text.pickUpLook"
                    Click="OnActionClicked" AutomationProperties.Name="Copy how this looks" />
          <MenuItem Header="Make it _look the same" Tag="text.putLookDown"
                    Click="OnActionClicked" AutomationProperties.Name="Make it look the same" />
          <MenuItem Header="Start a _new line, same paragraph" Tag="text.lineBreak"
                    InputGesture="Shift+Enter" Click="OnActionClicked"
                    AutomationProperties.Name="Start a new line, same paragraph" />
          <MenuItem Header="_Change capitals…" Tag="text.changeCase"
                    Click="OnActionClicked" AutomationProperties.Name="Change capitals" />
          <Separator />
          <MenuItem Header="Use a different font just _here…" Tag="text.fontJustHere"
                    Click="OnActionClicked" AutomationProperties.Name="Use a different font just here" />
          <MenuItem Header="P_ut it back to the usual font" Tag="text.clearFontOverride"
                    Click="OnActionClicked" AutomationProperties.Name="Put it back to the usual font" />
          <MenuItem Header="_Fonts and text styles…" Tag="text.fontsAndStyles" InputGesture="Ctrl+Shift+D"
                    Click="OnActionClicked" AutomationProperties.Name="Fonts and text styles" />
        </MenuItem>
        <MenuItem Header="H_ow many words…" Tag="text.wordCount"
                  Click="OnActionClicked" AutomationProperties.Name="How many words" />
        <Separator />
        <MenuItem Header="_Picture" AutomationProperties.Name="Picture">
          <MenuItem x:Name="ReplacePictureMenuItem" Header="P_ut a picture here…" Tag="picture.replace"
                    InputGesture="Ctrl+Shift+O" Click="OnActionClicked"
                    AutomationProperties.Name="Put a picture here" />
          <Separator />
          <MenuItem Header="_Fix this picture" Tag="picture.fix" InputGesture="Ctrl+Shift+F"
                    Click="OnActionClicked" AutomationProperties.Name="Fix this picture" />
          <MenuItem Header="Change how it _looks…" Tag="picture.adjust" InputGesture="Ctrl+Shift+A"
                    Click="OnActionClicked" AutomationProperties.Name="Change how the picture looks" />
          <MenuItem Header="Choose _which part shows…" Tag="picture.position"
                    Click="OnActionClicked" AutomationProperties.Name="Choose which part of the picture shows" />
          <MenuItem Header="Dis_miss this note" Tag="picture.dismissCropNotice"
                    Click="OnActionClicked" AutomationProperties.Name="Dismiss the stretched-picture note" />
          <Separator />
          <MenuItem x:Name="CaptionPictureMenuItem" Header="W_rite a caption…" Tag="picture.caption"
                    Click="OnActionClicked" AutomationProperties.Name="Write a caption for the picture" />
          <MenuItem Header="_Describe this picture…" Tag="picture.altText"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Describe this picture for people who cannot see it" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Insert" AutomationProperties.Name="Insert menu">
        <MenuItem Header="A box for _writing" Tag="insert.textFrame" InputGesture="Ctrl+Shift+T"
                  Click="OnActionClicked" AutomationProperties.Name="Add a box for writing" />
        <MenuItem Header="A _picture…" Tag="insert.photo" InputGesture="Ctrl+Shift+P"
                  Click="OnActionClicked" AutomationProperties.Name="Insert a picture" />
        <MenuItem Header="A box to _set something apart" Tag="insert.box"
                  Click="OnActionClicked"
                  AutomationProperties.Name="A box to set something apart" />
        <MenuItem Header="A li_ne across the page" Tag="insert.rule"
                  Click="OnActionClicked" AutomationProperties.Name="A line across the page" />
        <MenuItem Header="A character yo_u cannot type…" Tag="insert.symbol"
                  Click="OnActionClicked"
                  AutomationProperties.Name="A character you cannot type" />
        <Separator />
        <MenuItem Header="W_ords for hard news…" Tag="insert.phrase"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Words for hard news, such as a memorial" />
        <MenuItem Header="_Keep these words for next time…" Tag="insert.savePhrase"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Keep the highlighted words for next time" />
        <Separator />
        <!-- M101: the eight built-in lists and the two commands that fill two of them from the address book. Ten rows that were half the Insert menu. -->
        <MenuItem Header="_A lodge list" AutomationProperties.Name="A lodge list">
          <MenuItem Header="_Lodge officers" Tag="insert.officersTable"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Insert the lodge officers table" />
          <MenuItem Header="_Fill in the officers from the address book…" Tag="item.syncOfficers"
                    InputGesture="Ctrl+Shift+B" Click="OnActionClicked"
                    AutomationProperties.Name="Fill in the officers from the address book" />
          <Separator />
          <MenuItem Header="_Birthdays" Tag="insert.birthdayList"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Insert the birthday list" />
          <MenuItem Header="Brin_g in birthdays from the address book…" Tag="item.syncBirthdays"
                    InputGesture="Ctrl+Shift+U" Click="OnActionClicked"
                    AutomationProperties.Name="Bring in birthdays from the address book" />
          <Separator />
          <MenuItem Header="_Committees" Tag="insert.committeeList"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Insert the committee list" />
          <MenuItem Header="_District calendar" Tag="insert.districtCalendar"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Insert the district calendar" />
          <MenuItem Header="_This month&apos;s calendar" Tag="insert.monthCalendar"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Insert this month&apos;s calendar" />
          <MenuItem Header="_Announcement box" Tag="insert.eventCard"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Insert an announcement box" />
          <MenuItem Header="Cover _heading" Tag="insert.coverBanner"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Insert the cover heading" />
          <MenuItem Header="A list of m_y own" Tag="insert.simpleList"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Add a list of my own" />
        </MenuItem>
        <!-- M101: three ways of bringing in something that already exists. -->
        <MenuItem Header="So_mething from elsewhere" AutomationProperties.Name="Something from elsewhere">
          <MenuItem Header="Writing from a fil_e…" Tag="insert.writingFromFile"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Bring in writing from a Word document or a text file" />
          <MenuItem Header="A page f_rom a PDF…" Tag="insert.pdfPage"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Bring in a page from a PDF as a picture" />
          <MenuItem Header="An e_mblem…" Tag="insert.emblem"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Add one of the craft's emblems" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="A_rrange" AutomationProperties.Name="Arrange menu">
        <MenuItem Header="Make it _fit what is in it" Tag="item.fitToContents" InputGesture="Ctrl+Shift+Y"
                  Click="OnActionClicked" AutomationProperties.Name="Make it fit what is in it" />
        <MenuItem Header="M_ake another like this" Tag="item.duplicate" InputGesture="Ctrl+D"
                  Click="OnActionClicked" AutomationProperties.Name="Make another like this" />
        <MenuItem Header="Si_ze and place it exactly…" Tag="item.positionAndSize"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Size and place it exactly" />
        <Separator />
        <MenuItem Header="Kee_p it where it is" Tag="item.lock"
                  Click="OnActionClicked" AutomationProperties.Name="Keep it where it is" />
        <MenuItem Header="P_ut a border round it" Tag="item.border"
                  Click="OnActionClicked" AutomationProperties.Name="Put a border round it" />
        <MenuItem Header="S_hade it" Tag="item.shade"
                  Click="OnActionClicked" AutomationProperties.Name="Shade it" />
        <MenuItem Header="Change wha_t colour the box is…" Tag="item.shapeColours"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Change what colour the box is" />
        <MenuItem Header="Chang_e what colour the emblem is…" Tag="item.emblemColour"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Change what colour the emblem is" />
        <Separator />
        <MenuItem Header="Move what is chosen to the ne_xt page" Tag="item.moveToNextPage"
                  InputGesture="Ctrl+Shift+PageDown"
                  Click="OnActionClicked" AutomationProperties.Name="Move it to the next page" />
        <MenuItem Header="_Move what is chosen to the page before" Tag="item.moveToPreviousPage"
                  InputGesture="Ctrl+Shift+PageUp"
                  Click="OnActionClicked" AutomationProperties.Name="Move it to the page before" />
        <Separator />
        <!-- M101: six commands about how words move through frames, which is one subject and was the first six rows of Arrange. -->
        <MenuItem Header="H_ow the writing flows" AutomationProperties.Name="How the writing flows">
          <MenuItem Header="Make the _writing flow around it" Tag="flow.wrap" InputGesture="Ctrl+Shift+W"
                    Click="OnActionClicked" AutomationProperties.Name="Make the writing flow around it" />
          <MenuItem Header="Split i_nto two columns" Tag="flow.twoColumns"
                    Click="OnActionClicked" AutomationProperties.Name="Split into two columns" />
          <MenuItem Header="Make the bo_x taller" Tag="flow.growToFit"
                    Click="OnActionClicked" AutomationProperties.Name="Make the box taller" />
          <Separator />
          <MenuItem Header="_Continue this text in another frame…" Tag="flow.link" InputGesture="Ctrl+Shift+L"
                    Click="OnActionClicked" AutomationProperties.Name="Continue this text in another frame" />
          <MenuItem Header="_Stop continuing into the next frame" Tag="flow.unlink" InputGesture="Ctrl+Shift+K"
                    Click="OnActionClicked" AutomationProperties.Name="Stop continuing into the next frame" />
          <MenuItem Header="_Make the rest fit" Tag="flow.auto" InputGesture="Ctrl+Shift+M"
                    Click="OnActionClicked" AutomationProperties.Name="Make the rest of this text fit" />
        </MenuItem>
        <MenuItem Header="F_ront to back" AutomationProperties.Name="Front to back">
          <MenuItem Header="M_ove it forward" Tag="arrange.bringForward" InputGesture="Ctrl+OemCloseBrackets"
                    Click="OnActionClicked" AutomationProperties.Name="Move it forward" />
          <MenuItem Header="Move it _back" Tag="arrange.sendBackward" InputGesture="Ctrl+OemOpenBrackets"
                    Click="OnActionClicked" AutomationProperties.Name="Move it back" />
          <MenuItem Header="Move it to the f_ront" Tag="arrange.bringToFront" InputGesture="Ctrl+Shift+OemCloseBrackets"
                    Click="OnActionClicked" AutomationProperties.Name="Move it to the front" />
          <MenuItem Header="Move it to the bac_k" Tag="arrange.sendToBack" InputGesture="Ctrl+Shift+OemOpenBrackets"
                    Click="OnActionClicked" AutomationProperties.Name="Move it to the back" />
        </MenuItem>
        <!-- M101: eight rows that were a third of the Arrange menu and are one idea. -->
        <MenuItem Header="_Line them up" AutomationProperties.Name="Line them up">
          <MenuItem Header="_Line up the left edges" Tag="arrange.alignLeft"
                    Click="OnActionClicked" AutomationProperties.Name="Line up the left edges" />
          <MenuItem Header="Lin_e up the centres, side to side" Tag="arrange.alignCentres"
                    Click="OnActionClicked" AutomationProperties.Name="Line up the centres, side to side" />
          <MenuItem Header="L_ine up the right edges" Tag="arrange.alignRight"
                    Click="OnActionClicked" AutomationProperties.Name="Line up the right edges" />
          <Separator />
          <MenuItem Header="Line up _the top edges" Tag="arrange.alignTop"
                    Click="OnActionClicked" AutomationProperties.Name="Line up the top edges" />
          <MenuItem Header="Line up the mi_ddles, top to bottom" Tag="arrange.alignMiddles"
                    Click="OnActionClicked" AutomationProperties.Name="Line up the middles, top to bottom" />
          <MenuItem Header="Line up the bottom ed_ges" Tag="arrange.alignBottom"
                    Click="OnActionClicked" AutomationProperties.Name="Line up the bottom edges" />
          <Separator />
          <MenuItem Header="Space them out e_venly, side to side" Tag="arrange.distributeAcross"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Space them out evenly, side to side" />
          <MenuItem Header="Space them out evenl_y, top to bottom" Tag="arrange.distributeDown"
                    Click="OnActionClicked"
                    AutomationProperties.Name="Space them out evenly, top to bottom" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View" AutomationProperties.Name="View menu">
        <MenuItem Header="Zoom _in" Tag="view.zoomIn" InputGesture="Ctrl+OemPlus"
                  Click="OnActionClicked" AutomationProperties.Name="Zoom in" />
        <MenuItem Header="Z_oom out" Tag="view.zoomOut" InputGesture="Ctrl+OemMinus"
                  Click="OnActionClicked" AutomationProperties.Name="Zoom out" />
        <MenuItem Header="_Actual size" Tag="view.actualSize" InputGesture="Ctrl+D0"
                  Click="OnActionClicked" AutomationProperties.Name="Actual size" />
        <MenuItem Header="_Fit page" Tag="view.fitPage" InputGesture="Ctrl+D1"
                  Click="OnActionClicked" AutomationProperties.Name="Fit page" />
        <MenuItem Header="Fit the wid_th" Tag="view.fitWidth" InputGesture="Ctrl+D2"
                  Click="OnActionClicked" AutomationProperties.Name="Fit the width" />
        <Separator />
        <MenuItem Header="Show what I can _do" Tag="view.toggleActionPanel"
                  Click="OnActionClicked" AutomationProperties.Name="Show or hide the panel of things you can do" />
        <MenuItem Header="_Show the pages down the side" Tag="view.togglePageRail"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show or hide the pages down the side" />
        <Separator />
        <MenuItem Header="Show the ed_ge to keep inside" Tag="view.showMargins"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show the edge to keep inside" />
        <MenuItem Header="Sho_w where fonts were changed" Tag="view.showFontChanges"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show where fonts were changed" />
        <MenuItem Header="Show my spelling mista_kes" Tag="view.showSpelling"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show my spelling mistakes" />
        <Separator />
        <MenuItem Header="Move to the _next part of the window" Tag="view.nextRegion" InputGesture="F6"
                  Click="OnActionClicked" AutomationProperties.Name="Move to the next part of the window" />
        <MenuItem Header="Move to the _previous part of the window" Tag="view.previousRegion"
                  InputGesture="Shift+F6" Click="OnActionClicked"
                  AutomationProperties.Name="Move to the previous part of the window" />
        <Separator />
        <MenuItem Header="How things _look…" Tag="view.settings" InputGesture="F10" Click="OnActionClicked"
                  AutomationProperties.Name="Change how things look" />
      </MenuItem>
      <MenuItem Header="_Page" AutomationProperties.Name="Page menu">
        <MenuItem Header="_Next page" Tag="page.next" InputGesture="Ctrl+PageDown"
                  Click="OnActionClicked" AutomationProperties.Name="Next page" />
        <MenuItem Header="_Previous page" Tag="page.previous" InputGesture="Ctrl+PageUp"
                  Click="OnActionClicked" AutomationProperties.Name="Previous page" />
        <MenuItem Header="_Go to a page" Tag="page.goTo"
                  Click="OnActionClicked" AutomationProperties.Name="Go to a page" />
        <Separator />
        <MenuItem Header="_Add a page after this one" Tag="page.add" InputGesture="Ctrl+Shift+N"
                  Click="OnActionClicked" AutomationProperties.Name="Add a page after this one" />
        <MenuItem Header="Make ano_ther page like this one" Tag="page.duplicate"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Make another page like this one" />
        <MenuItem Header="_Delete this page" Tag="page.remove"
                  Click="OnActionClicked" AutomationProperties.Name="Delete this page" />
        <Separator />
        <MenuItem Header="Mov_e this page earlier" Tag="page.moveEarlier"
                  Click="OnActionClicked" AutomationProperties.Name="Move this page earlier" />
        <MenuItem Header="Move this page _later" Tag="page.moveLater"
                  Click="OnActionClicked" AutomationProperties.Name="Move this page later" />
        <Separator />
        <MenuItem Header="The paper and the _margins…" Tag="page.setup"
                  Click="OnActionClicked"
                  AutomationProperties.Name="The paper and the margins" />
        <MenuItem Header="Show page num_bers at the bottom" Tag="page.footer"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show page numbers at the bottom" />
        <MenuItem Header="Leave the _front page out of the numbering" Tag="page.footerNotOnFront"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Leave the front page out of the numbering" />
      </MenuItem>
      <MenuItem Header="Peop_le" AutomationProperties.Name="People menu">
        <MenuItem Header="_People…" Tag="people.show" InputGesture="Ctrl+Shift+R"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Open your lodge address book" />
        <Separator />
        <MenuItem Header="_Import from a file…" Tag="people.import"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Import members from a spreadsheet" />
        <MenuItem Header="_Save as a spreadsheet…" Tag="people.export"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Save your address book as a spreadsheet" />
        <Separator />
        <MenuItem x:Name="UndoPeopleMenuItem" Header="_Undo the last change" Tag="people.undo"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Undo the last change to your address book" />
        <MenuItem Header="_Restore an earlier version…" Tag="people.restore"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Restore an earlier version of your address book" />
      </MenuItem>
      <MenuItem Header="_Help" AutomationProperties.Name="Help menu">
        <MenuItem Header="_How do I…?" Tag="help.howDoI"
                  Click="OnActionClicked" InputGesture="F1"
                  AutomationProperties.Name="How do I…?" />
        <MenuItem Header="Show me _round again" Tag="help.tour"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show me round again" />
        <Separator />
        <MenuItem Header="_Check for an update" Tag="help.checkForUpdates"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Check for an update" />
        <MenuItem Header="Save a re_port of a problem…" Tag="help.problemReport"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Save a report of a problem" />
        <MenuItem Header="_Show me an example newsletter" Tag="help.exampleIssue"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show me an example newsletter" />
        <Separator />
        <MenuItem Header="_Licence" Tag="help.licence"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Licence" />
        <MenuItem Header="_Fonts and licences" Tag="help.fontLicences"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Fonts and licences" />
        <MenuItem Header="_About TrestleBoard" Tag="help.about"
                  Click="OnActionClicked"
                  AutomationProperties.Name="About TrestleBoard" />
      </MenuItem>
    </Menu>
    </LayoutTransformControl>

    <!-- Nine controls, down from eighteen (M11). Bold, italic, paragraph style, wrap, insert and
         arrange all moved into the panel, where they sit beside the thing they act on.

         M76: nine buttons became seven, and M11's rule that this bar must not grow back is not
         bent by it. Zoom out, Zoom in and Fit page left for the canvas footer, taking the zoom
         percentage with them — they act on the VIEW of the page rather than on the newsletter, and
         with them here the bar was wider than the window at its own default 1280, which is how
         "Fit page" came to be off screen in a committed screenshot. "Make the PDF" took part of the
         room they freed, and the bar is two controls SHORTER than before (docs/M76-spec.md §2, §3).

         M27: every label here is the label the menu uses for the same command. They used to differ
         — "Smaller"/"Bigger" against the View menu's "Zoom out"/"Zoom in", and a bare "Back"/"Next"
         against "Previous page"/"Next page". Two of those were worse than merely inconsistent:
         "Smaller"/"Bigger" is also what the font window's size stepper says, where it changes point
         size rather than zoom, and "Back"/"Next" is what the officers wizard's own buttons say. The
         same word doing two jobs in one program is how a user learns not to trust any of them. -->
    <LayoutTransformControl x:Name="ToolbarScale" DockPanel.Dock="Top">
    <Border Padding="8"
            Background="{DynamicResource TrestleBoard.Chrome.Background}"
            BorderBrush="{DynamicResource TrestleBoard.Chrome.Border}"
            BorderThickness="{DynamicResource TrestleBoard.Rule.Bottom}">
      <!-- Scrolls horizontally: at 200% the toolbar is wider than most windows, and a control the
           user cannot reach is the same as a control that is not there (PLAN.md §6). -->
      <!-- M69: AllowAutoHide=False so the bar is on screen whenever the toolbar is wider than the
           window. It auto-hid before, which meant the last button was simply cut off at the window
           edge with nothing to say it could be reached — the same failure this comment warns about,
           arriving through the scrollbar rather than through the overflow. -->
      <!-- M76(e), docs/M76-spec.md §3: two columns rather than one strip. "Make the PDF" is the
           terminal goal of the whole product — it is the file the committee emails to the lodge —
           and until now it appeared only inside the what's-next card, which scrolls, and only when
           that card decided to offer it. Here it is permanent, right-aligned, and deliberately
           OUTSIDE the scroller: a command that can be scrolled out of reach is not where you put
           the thing this audience came here to do. The scrolling group is declared first so Tab
           walks the bar left to right, the way it reads. -->
      <Grid ColumnDefinitions="*,Auto">
      <ScrollViewer x:Name="ToolbarStrip" Grid.Column="0"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    AllowAutoHide="False">
      <StackPanel x:Name="ToolbarStack" Orientation="Horizontal" Spacing="8">
        <Button x:Name="OpenButton" FontSize="16" MinHeight="44" Tag="newsletter.open" Click="OnActionClicked"
                AutomationProperties.Name="Open a newsletter">Open</Button>
        <!-- M41: the toolbar is where this audience looks first, and until now the one command they
             need most often was not on it. The label is a prefix of the catalog's "Save this
             newsletter", which is what keeps the toolbar and the menu saying the same word. -->
        <Button x:Name="SaveButton" FontSize="16" MinHeight="44" Tag="newsletter.save" Click="OnActionClicked"
                AutomationProperties.Name="Save this newsletter">Save</Button>
        <!-- The save state, in words, beside the button that changes it. The title bar has said this
             since M24, but a title bar is not where somebody looks to ask "is my work safe?". -->
        <TextBlock x:Name="SaveStateLabel" FontSize="16" VerticalAlignment="Center" MinWidth="96"
                   Text="" AutomationProperties.Name="Whether your work is saved"
                   AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="UndoButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="edit.undo" Click="OnActionClicked"
                AutomationProperties.Name="Undo">Undo</Button>
        <Button x:Name="RedoButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="edit.redo" Click="OnActionClicked"
                AutomationProperties.Name="Redo">Redo</Button>
        <Separator Width="12" Background="Transparent" />
        <Button x:Name="PrevPageButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="page.previous" Click="OnActionClicked"
                AutomationProperties.Name="Previous page">Previous page</Button>
        <TextBlock x:Name="PageLabel" FontSize="16" VerticalAlignment="Center" MinWidth="110"
                   TextAlignment="Center" Text="No newsletter"
                   AutomationProperties.Name="Current page" AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="NextPageButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="page.next" Click="OnActionClicked"
                AutomationProperties.Name="Next page">Next page</Button>
        <!-- M76(d): Zoom out, the percentage, Zoom in and Fit page USED TO SIT HERE, and that is
             why the bar overflowed at Width="1280" — the size the window chooses for itself. They
             act on the VIEW of the page, not on the newsletter, so they moved to the canvas footer
             below, where every document application this audience has ever used puts them. Their
             menu items, shortcuts and KeyboardMap rows are untouched: what moved is a command's
             second home, not the command (docs/M76-spec.md §2, §10). -->
      </StackPanel>
      </ScrollViewer>
      <!-- The one primary in this region, which is what makes it unambiguous (docs/M76-spec.md §3).
           The treatment is the PrimaryButton theme rather than IsDefault: IsDefault on a main
           window would also claim the Enter key for the whole shell, and Enter belongs to whatever
           the user is typing in. The label is the catalog's own title, so the toolbar and the File
           menu say the same words — M27's rule, and the reason PlainLanguageTests walks this bar. -->
      <Button x:Name="ExportPdfButton" Grid.Column="1" Margin="8,0,0,0"
              Theme="{DynamicResource TrestleBoard.PrimaryButton}"
              FontSize="16" MinHeight="44" Tag="newsletter.exportPdf" Click="OnActionClicked"
              AutomationProperties.Name="Make the PDF">Make the PDF…</Button>
      </Grid>
    </Border>
    </LayoutTransformControl>

    <!-- Plain-language status line: overset warnings, link prompts and the reason an action could
         not run all land here, never colour alone (PLAN.md §6, docs/M5-spec.md §8.4). -->
    <LayoutTransformControl x:Name="StatusScale" DockPanel.Dock="Bottom">
    <!-- The top rule is not decoration: without it the status bar floated against the canvas, and
         "colour is never the only signal" means the boundary survives the High Contrast swap. -->
    <Border Padding="12,8"
            Background="{DynamicResource TrestleBoard.Chrome.Background}"
            BorderBrush="{DynamicResource TrestleBoard.Chrome.Border}"
            BorderThickness="{DynamicResource TrestleBoard.Rule.Top}">
      <TextBlock x:Name="StatusLabel" FontSize="16" TextWrapping="Wrap" Text=""
                 AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
    </Border>
    </LayoutTransformControl>

    <!-- The panel honours the UI scale; the canvas deliberately does not, because the page has its
         own zoom (PLAN.md §11 M11, chrome budget). Below about 900px of window the panel folds
         itself away to the button beside it rather than squeezing the page out. -->
    <LayoutTransformControl x:Name="PanelScale" DockPanel.Dock="Right">
      <ContentControl x:Name="ActionPanelHost" />
    </LayoutTransformControl>

    <Border x:Name="CollapsedPanelHost" DockPanel.Dock="Right" Padding="4" IsVisible="False">
      <Button x:Name="ShowPanelButton" Classes="action" FontSize="16" MinHeight="44" VerticalAlignment="Top"
              Tag="view.toggleActionPanel" Click="OnActionClicked"
              AutomationProperties.Name="Show what I can do">What can I do? ▸</Button>
    </Border>

    <!-- THE PAGE RAIL (M76(g), docs/M76-spec.md §6). One miniature sheet per page, in order, down
         the left of the canvas. Until this milestone "Page 1 of 5" sat between two buttons and
         pressing Next three times was the only route to page four; a four-to-six page newsletter is
         small enough to show whole, and showing the plan laid out is what a trestle board IS.

         It is built in C# rather than declared here, because there is one tile per page of whatever
         newsletter happens to be open — see Actions/PageRail.cs, where the marking of the current
         page, the keyboard walk and the thumbnail cache all live.

         LEFT, and declared before the canvas so Tab reaches the pages before the page. It takes the
         UI scale like every other strip of chrome (RailScale joins the scale loop in ApplySettings),
         and it folds itself away to the labelled button below it under the same window width the
         action panel uses, because the page must never be squeezed out from both sides at once. -->
    <LayoutTransformControl x:Name="RailScale" DockPanel.Dock="Left">
      <ContentControl x:Name="PageRailHost" />
    </LayoutTransformControl>

    <Border x:Name="CollapsedRailHost" DockPanel.Dock="Left" Padding="4" IsVisible="False">
      <Button x:Name="ShowRailButton" Classes="action" FontSize="16" MinHeight="44" VerticalAlignment="Top"
              Tag="view.togglePageRail" Click="OnActionClicked"
              AutomationProperties.Name="Show the pages down the side">◂ Pages</Button>
    </Border>

    <!-- M76(d): the canvas region is the scroller PLUS the strip of chrome that belongs to the
         VIEW of the page. Two rows rather than one, and the scroller is declared first so Tab
         reaches the page before the controls that magnify it — page, then footer, then the status
         line, which is the order they read down the window. -->
    <Grid RowDefinitions="*,Auto">
    <!-- The backdrop is painted twice — here and in Canvas/PageCanvasControl.cs — and the two must
         move together, because they meet wherever the page does not fill the scroller. Neither is
         the document: both fill the area AROUND the sheet, which is chrome. -->
    <ScrollViewer x:Name="CanvasScroller" Grid.Row="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource TrestleBoard.Page.Backdrop}"
                  SizeChanged="OnScrollerSizeChanged">
      <canvas:PageCanvasControl x:Name="PageCanvas"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnCanvasDragOver"
                                DragDrop.Drop="OnCanvasDrop"
                                AutomationProperties.Name="Newsletter page editor" />
    </ScrollViewer>

    <!-- THE CANVAS FOOTER (M76(d), docs/M76-spec.md §2). The four controls that act on the view of
         the page rather than on the newsletter: Zoom out, the percentage, Zoom in, Fit page. They
         were on the toolbar, where they made it wider than the window at the default 1280 and put
         "Fit page" off screen behind M69's permanent scroll track.

         IT IS DOCKED, NOT FLOATING. A footer floating over the scroller would sit on top of the
         bottom of the sheet — which is the last line of somebody's article — and the sheet is the
         one thing in this window that must never be covered up. Docked, it also cannot scroll away
         with the page: it is a row of the canvas region, not a child of the scroller.

         AND IT IS CHROME, SO IT SCALES. The canvas deliberately does NOT take the UI scale, because
         the page has its own zoom (PLAN.md §11 M11, and see ApplySettings). The footer sits on the
         other side of that line: it is not the page, it is the buttons ABOUT the page, and its
         labels are 16pt UI text that an elderly user raising the interface to 150% needs raised
         with everything else. So CanvasFooterScale joins MenuScale/ToolbarScale/StatusScale/
         PanelScale in the scale loop, and the scroller between them stays untransformed. -->
    <LayoutTransformControl x:Name="CanvasFooterScale" Grid.Row="1">
      <Border Padding="8,6"
              Background="{DynamicResource TrestleBoard.Chrome.Background}"
              BorderBrush="{DynamicResource TrestleBoard.Chrome.Border}"
              BorderThickness="{DynamicResource TrestleBoard.Rule.Top}">
        <!-- IT SCROLLS, FOR THE REASON M69 MADE THE TOOLBAR SCROLL, and it was scale-200.png that
             asked for this too. The canvas region is what is left after the rail and the panel have
             taken their room, so at 200% these four scaled buttons are wider than it — and without
             a scroller "Zoom in" and "Fit page" were simply cut off at the panel's edge with
             nothing on screen to say they could be reached. That is the exact failure M69 wrote
             AllowAutoHide=False against: a control the user cannot reach is the same as a control
             that is not there (PLAN.md §6). An auto-hiding bar would not do, because it appears
             only once the pointer is already over it. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">
        <!-- No Classes="action" is written here, exactly as none is written on the toolbar:
             DressToolbar applies the M37 pressable affordance to every button in both strips, and
             one place that cannot be forgotten beats four attributes that can. -->
        <StackPanel x:Name="CanvasFooterStack" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="How large the page is shown">
          <Button x:Name="ZoomOutButton" FontSize="16" MinHeight="44" MinWidth="44"
                  Tag="view.zoomOut" Click="OnActionClicked"
                  AutomationProperties.Name="Zoom out">Zoom out</Button>
          <!-- M76(d), docs/M76-spec.md §7: the percentage used to be dead text sitting between two
               steppers — the one place in the window that showed a number and would not let you
               change it. It is a button now, and it opens the same ladder of magnifications the
               steppers walk, so somebody who wants 200% gets there in one press instead of four.

               The TextBlock is kept INSIDE the button rather than replaced by a string Content, and
               that is deliberate: the live-region announcement is made by the text element, and a
               Button's automation name is "Current zoom", which never changes and would therefore
               announce nothing when the zoom did. -->
          <Button x:Name="ZoomLadderButton" FontSize="16" MinHeight="44" MinWidth="72"
                  Click="OnZoomLadderClicked"
                  AutomationProperties.Name="Current zoom — press to choose how large the page is shown">
            <TextBlock x:Name="ZoomLabel" FontSize="16" TextAlignment="Center" Text="100%"
                       AutomationProperties.Name="Current zoom"
                       AutomationProperties.LiveSetting="Polite" />
          </Button>
          <Button x:Name="ZoomInButton" FontSize="16" MinHeight="44" MinWidth="44"
                  Tag="view.zoomIn" Click="OnActionClicked"
                  AutomationProperties.Name="Zoom in">Zoom in</Button>
          <Button x:Name="FitButton" FontSize="16" MinHeight="44"
                  Tag="view.fitPage" Click="OnActionClicked"
                  AutomationProperties.Name="Fit the whole page in the window">Fit page</Button>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </LayoutTransformControl>
    </Grid>
  </DockPanel>
</Window>
