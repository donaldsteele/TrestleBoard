<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="using:TrestleBoard.App.Canvas"
        x:Class="TrestleBoard.App.MainWindow"
        Title="TrestleBoard"
        Width="1280" Height="860"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="TrestleBoard main window">
  <!-- Minimum 16pt UI text, every action keyboard-reachable (PLAN.md §6). Every menu item carries
       the action id it runs in Tag and shares one Click handler: availability, the plain-language
       reason it is unavailable, and the code that performs it all come from one place (M11). -->
  <DockPanel>
    <LayoutTransformControl x:Name="MenuScale" DockPanel.Dock="Top">
    <Menu FontSize="16">
      <MenuItem Header="_File" AutomationProperties.Name="File menu">
        <MenuItem Header="_Open a newsletter…" Tag="newsletter.open"
                  InputGesture="Ctrl+O" Click="OnActionClicked"
                  AutomationProperties.Name="Open a newsletter" />
        <MenuItem Header="Open the _sample newsletter" Tag="newsletter.openSample"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Open the sample newsletter" />
        <Separator />
        <MenuItem Header="Start from a _template…" Tag="newsletter.newFromTemplate"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Start from a template" />
        <MenuItem Header="Start from _last month" Tag="newsletter.startFromLastMonth"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Start this month from last month's newsletter" />
        <Separator />
        <MenuItem Header="_Export as PDF…" Tag="newsletter.exportPdf"
                  InputGesture="Ctrl+E" Click="OnActionClicked"
                  AutomationProperties.Name="Export as PDF" />
        <Separator />
        <MenuItem Header="E_xit" Tag="newsletter.exit" Click="OnActionClicked"
                  AutomationProperties.Name="Exit TrestleBoard" />
      </MenuItem>
      <MenuItem Header="_Edit" AutomationProperties.Name="Edit menu">
        <MenuItem x:Name="UndoMenuItem" Header="_Undo" Tag="edit.undo"
                  InputGesture="Ctrl+Z" Click="OnActionClicked" AutomationProperties.Name="Undo" />
        <MenuItem x:Name="RedoMenuItem" Header="_Redo" Tag="edit.redo"
                  InputGesture="Ctrl+Y" Click="OnActionClicked" AutomationProperties.Name="Redo" />
        <Separator />
        <MenuItem Header="Cu_t" Tag="edit.cut" InputGesture="Ctrl+X"
                  Click="OnActionClicked" AutomationProperties.Name="Cut" />
        <MenuItem Header="_Copy" Tag="edit.copy" InputGesture="Ctrl+C"
                  Click="OnActionClicked" AutomationProperties.Name="Copy" />
        <MenuItem Header="_Paste" Tag="edit.paste" InputGesture="Ctrl+V"
                  Click="OnActionClicked" AutomationProperties.Name="Paste" />
        <Separator />
        <MenuItem Header="Select _all" Tag="edit.selectAll" InputGesture="Ctrl+A"
                  Click="OnActionClicked" AutomationProperties.Name="Select all" />
      </MenuItem>
      <!-- Paragraph style used to be a toolbar combo with no menu path at all — the one command
           in the app that a keyboard-only user could not reach (M11). -->
      <MenuItem Header="F_ormat" AutomationProperties.Name="Format menu">
        <MenuItem Header="_Bold" Tag="text.bold" InputGesture="Ctrl+B"
                  Click="OnActionClicked" AutomationProperties.Name="Bold" />
        <MenuItem Header="_Italic" Tag="text.italic" InputGesture="Ctrl+I"
                  Click="OnActionClicked" AutomationProperties.Name="Italic" />
        <Separator />
        <MenuItem x:Name="ParagraphStyleMenu" Header="Paragraph _style" Tag="text.paragraphStyle"
                  AutomationProperties.Name="Paragraph style" />
        <Separator />
        <!-- M14. The primary path to the font picker: §6 requires every command to have a menu
             item, and this one is the whole milestone. -->
        <MenuItem Header="_Fonts and text styles…" Tag="text.fontsAndStyles" InputGesture="Ctrl+Shift+D"
                  Click="OnActionClicked" AutomationProperties.Name="Fonts and text styles" />
        <MenuItem Header="Make text bi_gger" Tag="text.bigger" InputGesture="Ctrl+Shift+OemPeriod"
                  Click="OnActionClicked" AutomationProperties.Name="Make text bigger" />
        <MenuItem Header="Make text small_er" Tag="text.smaller" InputGesture="Ctrl+Shift+OemComma"
                  Click="OnActionClicked" AutomationProperties.Name="Make text smaller" />
        <Separator />
        <MenuItem Header="Use a different font just _here…" Tag="text.fontJustHere"
                  Click="OnActionClicked" AutomationProperties.Name="Use a different font just here" />
        <MenuItem Header="Put it back to the _usual font" Tag="text.clearFontOverride"
                  Click="OnActionClicked" AutomationProperties.Name="Put it back to the usual font" />
      </MenuItem>
      <!-- Insert menu: the six widgets each get their own item so a keyboard user never has to
           go through a picker (docs/M7-spec.md §8.1). -->
      <MenuItem Header="_Insert" AutomationProperties.Name="Insert menu">
        <MenuItem Header="_Lodge officers" Tag="insert.officersTable"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Insert the lodge officers table" />
        <MenuItem Header="_Birthdays" Tag="insert.birthdayList"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Insert the birthday list" />
        <!-- M13: the address book fills the birthday list in. It sits beside "Birthdays" because
             that is where a user looks for it; the panel offers it beside the selected list. -->
        <MenuItem Header="Brin_g in birthdays from the address book…" Tag="item.syncBirthdays"
                  InputGesture="Ctrl+Shift+U" Click="OnActionClicked"
                  AutomationProperties.Name="Bring in birthdays from the address book" />
        <MenuItem Header="_Committees" Tag="insert.committeeList"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Insert the committee list" />
        <MenuItem Header="_District calendar" Tag="insert.districtCalendar"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Insert the district calendar" />
        <MenuItem Header="_Announcement box" Tag="insert.eventCard"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Insert an announcement box" />
        <MenuItem Header="Cover _heading" Tag="insert.coverBanner"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Insert the cover heading" />
      </MenuItem>
      <!-- Was "Object", fourteen flat items deep. Same commands, six direct entries and three
           submenus, named for what the user is looking at rather than for a model type (M11).
           Nothing was removed; the four front-to-back items simply went one level deeper. -->
      <MenuItem Header="_This item" AutomationProperties.Name="This item menu">
        <MenuItem Header="_Add a text frame" Tag="insert.textFrame" InputGesture="Ctrl+Shift+T"
                  Click="OnActionClicked" AutomationProperties.Name="Add a text frame" />
        <MenuItem Header="_Delete this" Tag="item.delete" InputGesture="Delete"
                  Click="OnActionClicked" AutomationProperties.Name="Delete this" />
        <Separator />
        <MenuItem Header="_Change what this says…" Tag="item.edit" InputGesture="Ctrl+Shift+E"
                  Click="OnActionClicked" AutomationProperties.Name="Change what this item says" />
        <MenuItem Header="Edit the _list…" Tag="item.editList" InputGesture="Ctrl+Shift+G"
                  Click="OnActionClicked" AutomationProperties.Name="Edit this list" />
        <MenuItem Header="_Fit to contents" Tag="item.fitToContents" InputGesture="Ctrl+Shift+Y"
                  Click="OnActionClicked" AutomationProperties.Name="Fit this item to its contents" />
        <MenuItem Header="_Make the rest fit" Tag="flow.auto" InputGesture="Ctrl+Shift+M"
                  Click="OnActionClicked" AutomationProperties.Name="Make the rest of this text fit" />
        <Separator />
        <MenuItem Header="_Picture" AutomationProperties.Name="Picture submenu">
          <MenuItem Header="_Insert a picture…" Tag="insert.photo" InputGesture="Ctrl+Shift+P"
                    Click="OnActionClicked" AutomationProperties.Name="Insert a picture" />
          <MenuItem Header="_Fix this picture" Tag="picture.fix" InputGesture="Ctrl+Shift+F"
                    Click="OnActionClicked" AutomationProperties.Name="Fix this picture" />
          <MenuItem Header="_Adjust the picture…" Tag="picture.adjust" InputGesture="Ctrl+Shift+A"
                    Click="OnActionClicked" AutomationProperties.Name="Adjust the picture" />
        </MenuItem>
        <MenuItem Header="_Text flow" AutomationProperties.Name="Text flow submenu">
          <MenuItem Header="_Wrap text around this" Tag="flow.wrap" InputGesture="Ctrl+Shift+W"
                    Click="OnActionClicked" AutomationProperties.Name="Wrap text around this frame" />
          <MenuItem Header="_Continue this text in another frame…" Tag="flow.link" InputGesture="Ctrl+Shift+L"
                    Click="OnActionClicked" AutomationProperties.Name="Continue this text in another frame" />
          <MenuItem Header="_Stop continuing into the next frame" Tag="flow.unlink" InputGesture="Ctrl+Shift+K"
                    Click="OnActionClicked" AutomationProperties.Name="Stop continuing into the next frame" />
        </MenuItem>
        <MenuItem Header="A_rrange" AutomationProperties.Name="Arrange submenu">
          <MenuItem Header="Bring _forward" Tag="arrange.bringForward" InputGesture="Ctrl+OemCloseBrackets"
                    Click="OnActionClicked" AutomationProperties.Name="Bring forward" />
          <MenuItem Header="Send _backward" Tag="arrange.sendBackward" InputGesture="Ctrl+OemOpenBrackets"
                    Click="OnActionClicked" AutomationProperties.Name="Send backward" />
          <MenuItem Header="Bring to f_ront" Tag="arrange.bringToFront" InputGesture="Ctrl+Shift+OemCloseBrackets"
                    Click="OnActionClicked" AutomationProperties.Name="Bring to front" />
          <MenuItem Header="Send to bac_k" Tag="arrange.sendToBack" InputGesture="Ctrl+Shift+OemOpenBrackets"
                    Click="OnActionClicked" AutomationProperties.Name="Send to back" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View" AutomationProperties.Name="View menu">
        <MenuItem Header="Zoom _in" Tag="view.zoomIn" InputGesture="Ctrl+OemPlus"
                  Click="OnActionClicked" AutomationProperties.Name="Zoom in" />
        <MenuItem Header="Zoom _out" Tag="view.zoomOut" InputGesture="Ctrl+OemMinus"
                  Click="OnActionClicked" AutomationProperties.Name="Zoom out" />
        <MenuItem Header="_Actual size" Tag="view.actualSize" InputGesture="Ctrl+D0"
                  Click="OnActionClicked" AutomationProperties.Name="Actual size" />
        <MenuItem Header="_Fit page" Tag="view.fitPage" InputGesture="Ctrl+D1"
                  Click="OnActionClicked" AutomationProperties.Name="Fit page" />
        <Separator />
        <MenuItem Header="Show what I can _do" Tag="view.toggleActionPanel"
                  Click="OnActionClicked" AutomationProperties.Name="Show or hide the panel of things you can do" />
        <MenuItem Header="Show _where fonts were changed" Tag="view.showFontChanges"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show where fonts were changed" />
        <MenuItem Header="Move to the _next part of the window" Tag="view.nextRegion" InputGesture="F6"
                  Click="OnActionClicked" AutomationProperties.Name="Move to the next part of the window" />
        <Separator />
        <MenuItem Header="How things _look…" Tag="view.settings" Click="OnActionClicked"
                  AutomationProperties.Name="Change how things look" />
      </MenuItem>
      <MenuItem Header="_Page" AutomationProperties.Name="Page menu">
        <!-- Ctrl+PageUp/Down: bare PageUp/Down belongs to the caret while editing (M4 spec §4.3). -->
        <MenuItem Header="_Next page" Tag="page.next" InputGesture="Ctrl+PageDown"
                  Click="OnActionClicked" AutomationProperties.Name="Next page" />
        <MenuItem Header="_Previous page" Tag="page.previous" InputGesture="Ctrl+PageUp"
                  Click="OnActionClicked" AutomationProperties.Name="Previous page" />
        <Separator />
        <MenuItem Header="_Add a page after this one" Tag="page.add"
                  Click="OnActionClicked" AutomationProperties.Name="Add a page after this one" />
        <MenuItem Header="_Delete this page" Tag="page.remove"
                  Click="OnActionClicked" AutomationProperties.Name="Delete this page" />
        <MenuItem Header="Move this page _earlier" Tag="page.moveEarlier"
                  Click="OnActionClicked" AutomationProperties.Name="Move this page earlier" />
        <MenuItem Header="Move this page _later" Tag="page.moveLater"
                  Click="OnActionClicked" AutomationProperties.Name="Move this page later" />
      </MenuItem>
      <!-- Top-level rather than buried in File (M12): the address book becomes one of the five
           things this app does, and the whole point of it is that a name is typed once. -->
      <MenuItem Header="Peop_le" AutomationProperties.Name="People menu">
        <MenuItem Header="_People…" Tag="people.show" InputGesture="Ctrl+Shift+R"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Open your lodge address book" />
        <Separator />
        <MenuItem Header="_Import from a file…" Tag="people.import"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Import members from a spreadsheet" />
        <MenuItem Header="_Save as a spreadsheet…" Tag="people.export"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Save your address book as a spreadsheet" />
        <Separator />
        <MenuItem x:Name="UndoPeopleMenuItem" Header="_Undo the last change" Tag="people.undo"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Undo the last change to your address book" />
        <MenuItem Header="_Restore an earlier version…" Tag="people.restore"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Restore an earlier version of your address book" />
      </MenuItem>
      <!-- Updates are automatic and quiet (docs/M10-spec.md §2); this item exists so someone who
           wonders "am I on the newest one?" gets an answer instead of having to wonder. -->
      <MenuItem Header="_Help" AutomationProperties.Name="Help menu">
        <MenuItem Header="_Check for an update" Tag="help.checkForUpdates"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Check for an update" />
        <!-- M15: the five-page example issue used to be a fixture only the tests could reach. -->
        <MenuItem Header="_Show me an example newsletter" Tag="help.exampleIssue"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Show me an example newsletter" />
        <Separator />
        <MenuItem Header="_Fonts and licences" Tag="help.fontLicences"
                  Click="OnActionClicked"
                  AutomationProperties.Name="Fonts and licences" />
        <MenuItem Header="_About TrestleBoard" Tag="help.about"
                  Click="OnActionClicked"
                  AutomationProperties.Name="About TrestleBoard" />
      </MenuItem>
    </Menu>
    </LayoutTransformControl>

    <!-- Nine controls, down from eighteen (M11). Bold, italic, paragraph style, wrap, insert and
         arrange all moved into the panel, where they sit beside the thing they act on. -->
    <LayoutTransformControl x:Name="ToolbarScale" DockPanel.Dock="Top">
    <Border Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <!-- Scrolls horizontally: at 200% the toolbar is wider than most windows, and a control the
           user cannot reach is the same as a control that is not there (PLAN.md §6). -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="OpenButton" FontSize="16" MinHeight="44" Tag="newsletter.open" Click="OnActionClicked"
                AutomationProperties.Name="Open a newsletter">Open</Button>
        <Button x:Name="UndoButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="edit.undo" Click="OnActionClicked"
                AutomationProperties.Name="Undo">↶ Undo</Button>
        <Button x:Name="RedoButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="edit.redo" Click="OnActionClicked"
                AutomationProperties.Name="Redo">↷ Redo</Button>
        <Separator Width="12" Background="Transparent" />
        <Button x:Name="PrevPageButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="page.previous" Click="OnActionClicked"
                AutomationProperties.Name="Previous page">◀ Back</Button>
        <TextBlock x:Name="PageLabel" FontSize="16" VerticalAlignment="Center" MinWidth="110"
                   TextAlignment="Center" Text="No newsletter"
                   AutomationProperties.Name="Current page" AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="NextPageButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="page.next" Click="OnActionClicked"
                AutomationProperties.Name="Next page">Next ▶</Button>
        <Button x:Name="ZoomOutButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="view.zoomOut" Click="OnActionClicked"
                AutomationProperties.Name="Zoom out">− Smaller</Button>
        <TextBlock x:Name="ZoomLabel" FontSize="16" VerticalAlignment="Center" MinWidth="64"
                   TextAlignment="Center" Text="100%"
                   AutomationProperties.Name="Current zoom" AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="ZoomInButton" FontSize="16" MinHeight="44" MinWidth="44" Tag="view.zoomIn" Click="OnActionClicked"
                AutomationProperties.Name="Zoom in">+ Bigger</Button>
        <Button x:Name="FitButton" FontSize="16" MinHeight="44" Tag="view.fitPage" Click="OnActionClicked"
                AutomationProperties.Name="Fit the whole page in the window">Fit page</Button>
      </StackPanel>
      </ScrollViewer>
    </Border>
    </LayoutTransformControl>

    <!-- Plain-language status line: overset warnings, link prompts and the reason an action could
         not run all land here, never colour alone (PLAN.md §6, docs/M5-spec.md §8.4). -->
    <LayoutTransformControl x:Name="StatusScale" DockPanel.Dock="Bottom">
    <Border Padding="12,8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock x:Name="StatusLabel" FontSize="16" TextWrapping="Wrap" Text=""
                 AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
    </Border>
    </LayoutTransformControl>

    <!-- The panel honours the UI scale; the canvas deliberately does not, because the page has its
         own zoom (PLAN.md §11 M11, chrome budget). Below about 900px of window the panel folds
         itself away to the button beside it rather than squeezing the page out. -->
    <LayoutTransformControl x:Name="PanelScale" DockPanel.Dock="Right">
      <ContentControl x:Name="ActionPanelHost" />
    </LayoutTransformControl>

    <Border x:Name="CollapsedPanelHost" DockPanel.Dock="Right" Padding="4" IsVisible="False">
      <Button x:Name="ShowPanelButton" FontSize="16" MinHeight="44" VerticalAlignment="Top"
              Tag="view.toggleActionPanel" Click="OnActionClicked"
              AutomationProperties.Name="Show what I can do">What can I do? ▸</Button>
    </Border>

    <ScrollViewer x:Name="CanvasScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="#FF6B6B6B"
                  SizeChanged="OnScrollerSizeChanged">
      <canvas:PageCanvasControl x:Name="PageCanvas"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnCanvasDragOver"
                                DragDrop.Drop="OnCanvasDrop"
                                AutomationProperties.Name="Newsletter page editor" />
    </ScrollViewer>
  </DockPanel>
</Window>
