<!--
  A TRUE high-contrast palette (PLAN.md §6 asks for 7:1+). Pure white on pure black is 21:1, and
  every accent below is checked against black at 7:1 or better:
    #FFFF00 yellow  19.6:1   #00FFFF cyan  16.7:1   #7FFF7F green  14.6:1   #FF9E9E red  9.6:1

  Focus and selection are yellow because they must be unmistakable at a glance, and because yellow
  on black is the highest-contrast pairing available after plain white. Every rule also changes a
  BORDER, not only a colour: PLAN.md §6 says colour is never the only signal, and a high-contrast
  user may also have colour vision differences.

  This styles the CHROME only. The page itself stays white, because the user is laying out something
  that will be printed on paper (docs/M9-spec.md §4).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="TrestleBoardChromeBackground" Color="#FF000000" />
    <SolidColorBrush x:Key="TrestleBoardChromeForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TrestleBoardFocus" Color="#FFFFFF00" />
    <SolidColorBrush x:Key="TrestleBoardWarning" Color="#FFFF9E9E" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="#FF000000" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="#FF000000" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button:focus">
    <Setter Property="BorderBrush" Value="#FFFFFF00" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="Background" Value="#FF000000" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ToggleButton:checked">
    <Setter Property="BorderBrush" Value="#FFFFFF00" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="#FF000000" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#FF000000" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="#FF000000" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Background" Value="#FF000000" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>

  <Style Selector="Border">
    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
  </Style>
</Styles>
