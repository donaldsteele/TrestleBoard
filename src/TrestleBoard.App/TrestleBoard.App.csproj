<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia shell. ONLY project referencing Avalonia (PLAN.md §9). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The release workflow overrides Version from the tag (-p:Version=1.2.3); this default is
         what a local `dotnet run` reports. The assembly name stays TrestleBoard.App because the
         theme resources are addressed as avares://TrestleBoard.App/… (Settings/ThemeManager.cs). -->
    <Version>0.1.0</Version>
    <Product>TrestleBoard</Product>
    <Company>Indian Land Masonic Lodge 414</Company>
    <Description>Trestle board newsletter editor for Indian Land Masonic Lodge 414</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Direct refs override Avalonia.Skia's transitive 2.88/7.x Linux natives, keeping the
         native libraries in lockstep with the managed SkiaSharp 3.119.4 / HarfBuzzSharp 8.3.1.5
         pins. Without these, ubuntu loads libSkiaSharp 88.1 and every Skia call throws. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <!-- M10: installer, auto-update from GitHub Releases, and the .tboard association. -->
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrestleBoard.Core\TrestleBoard.Core.csproj" />
    <ProjectReference Include="..\TrestleBoard.Editing\TrestleBoard.Editing.csproj" />
    <ProjectReference Include="..\TrestleBoard.Layout\TrestleBoard.Layout.csproj" />
    <ProjectReference Include="..\TrestleBoard.Rendering\TrestleBoard.Rendering.csproj" />
    <ProjectReference Include="..\TrestleBoard.Emblems\TrestleBoard.Emblems.csproj" />
    <ProjectReference Include="..\TrestleBoard.Imaging\TrestleBoard.Imaging.csproj" />
    <ProjectReference Include="..\TrestleBoard.PdfPages\TrestleBoard.PdfPages.csproj" />
    <ProjectReference Include="..\TrestleBoard.Widgets\TrestleBoard.Widgets.csproj" />
    <ProjectReference Include="..\TrestleBoard.Roster\TrestleBoard.Roster.csproj" />
    <ProjectReference Include="..\TrestleBoard.Spelling\TrestleBoard.Spelling.csproj" />
    <ProjectReference Include="..\TrestleBoard.Export.Pdf\TrestleBoard.Export.Pdf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- M16: the application had no window icon at all. Every window showed the platform's generic
         placeholder while the very same PNG was being compiled into the Windows installer, the
         AppImage and the .icns. Linked rather than copied, so there is still exactly one drawing of
         this icon in the repository (assets-src/icons/README.md says how to redraw it). -->
    <AvaloniaResource Include="..\..\assets-src\icons\trestleboard.png" Link="Theme\trestleboard.png" />
    <!-- M76 (c). CHROME TYPEFACE. The application shipped twenty-two licensed families and set its
         own window text in whatever the OS handed it — the one thing in a program built on "the
         same bytes everywhere" that differed on all three platforms.

         These are LINKS, not copies. There is still exactly one SourceSans3-Regular.ttf and one
         Cinzel-Regular.ttf in this repository, both under assets-src/fonts/, both registered with
         their SHA-256 in assets-src/fonts/fonts.json, which stays the single register of what this
         program ships (M14). The window icon above set the precedent for linking an asset out of
         assets-src rather than duplicating it.

         The second item can NOT be avoided by pointing avares:// at TrestleBoard.Layout: those
         bytes are <EmbeddedResource> in a project that does not reference Avalonia (PLAN.md §9 —
         App is the only one that does), so no Avalonia resource blob exists there for the asset
         loader to read. The bytes therefore appear twice in the BUILD OUTPUT (~1.0 MB) — once for
         HarfBuzz to shape the document with, once for Avalonia to draw the chrome with — and once
         only in the repository, which is where the licence-tracking hazard lives.

         Two families and no more: chrome is Source Sans 3, the start screen's wordmark is Cinzel
         (docs/M76-spec.md §5). Adding a third means editing this list on purpose. -->
    <AvaloniaResource Include="..\..\assets-src\fonts\source-sans-3\*.ttf" Link="Theme\Fonts\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\assets-src\fonts\cinzel\*.ttf" Link="Theme\Fonts\%(Filename)%(Extension)" />
    <!-- M68: the application's own licence, embedded on the M14 font-licence precedent so it
         travels inside the assembly and reaches every installer without a copy step. PolyForm
         Noncommercial §Notices requires that anyone who gets a copy of the software also gets
         these terms; a file only present in the git repository would not satisfy that. -->
    <EmbeddedResource Include="..\..\LICENSE" Link="LICENSE" LogicalName="TrestleBoard.App.LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="App.HeadlessTests" />
    <!-- M15's documentation harness drives the real windows the same way the headless tests do.
         Neither is shipped (PLAN.md §9, "the Avalonia rule, stated precisely"). -->
    <InternalsVisibleTo Include="TrestleBoard.Screenshots" />
  </ItemGroup>
</Project>
