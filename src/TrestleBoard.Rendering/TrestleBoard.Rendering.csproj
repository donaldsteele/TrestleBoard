<Project Sdk="Microsoft.NET.Sdk">
  <!-- PageRenderer (→ SKCanvas), bundled font store.
       Imaging is referenced so painting can apply photo recipes; that is the one dependency
       edge M6 adds (docs/M6-spec.md §0) — the alternative was a second copy of auto-levels. -->
  <ItemGroup>
    <ProjectReference Include="..\TrestleBoard.Core\TrestleBoard.Core.csproj" />
    <ProjectReference Include="..\TrestleBoard.Layout\TrestleBoard.Layout.csproj" />
    <ProjectReference Include="..\TrestleBoard.Imaging\TrestleBoard.Imaging.csproj" />
  </ItemGroup>

  <!-- M78: the snapshot tests prove that turning the page footer off puts the pixels back, which
       means reaching the page master THIS source resolved rather than a copy of it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Rendering.SnapshotTests" />
  </ItemGroup>
</Project>
