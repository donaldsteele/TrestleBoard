<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shaping, line breaking, exclusion segments, pagination → LayoutResult.
       Owns the bundled font store: the OFL font bytes are embedded here (not in Rendering)
       because shaping needs them and Rendering references Layout — see docs/M1-spec.md §0. -->
  <ItemGroup>
    <ProjectReference Include="..\TrestleBoard.Core\TrestleBoard.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <!-- One glob, but LogicalName is still written out explicitly, so FontStore.LoadResource's
         contract ("TrestleBoard.Layout.Fonts." + filename) is unchanged. The glob's one hidden
         coupling is that TTF filenames must be globally unique across the family folders — which
         is exactly what Layout.Tests/FontManifestTests enforces. Which faces exist, where they
         came from and what their bytes hash to lives in assets-src/fonts/fonts.json. -->
    <EmbeddedResource Include="..\..\assets-src\fonts\**\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" LogicalName="TrestleBoard.Layout.Fonts.%(Filename)%(Extension)" />
    <!-- OFL §II(3): the licence must accompany the fonts in any distribution. Before M14 these
         lived in the repo only and never reached the installer. -->
    <EmbeddedResource Include="..\..\assets-src\fonts\THIRD-PARTY-FONTS.txt" Link="Assets\Fonts\THIRD-PARTY-FONTS.txt" LogicalName="TrestleBoard.Layout.Fonts.THIRD-PARTY-FONTS.txt" />
  </ItemGroup>
</Project>
