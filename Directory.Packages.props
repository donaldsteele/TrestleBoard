<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Pinned at M0 (PLAN.md §1). Avalonia stays on the 11.3.x line the plan locks in;
       SkiaSharp/HarfBuzzSharp get pinned during the M1 spike that validates their packaging. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Headless" Version="11.3.18" />
  </ItemGroup>

  <!-- Pinned at M1. SkiaSharp stays on the 3.x line (4.x exists but is untested against the
       Avalonia 11.3.x lock); HarfBuzzSharp 8.3.1.5 is the exact pair SkiaSharp.HarfBuzz 3.119.4
       depends on. NativeAssets packages are required for the ubuntu CI leg; the NoDependencies
       Skia variant avoids the fontconfig chain — we never touch system fonts. -->
  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- Avalonia.Skia transitively requests the 2.88 Linux natives; a direct reference in App
         forces 3.119.4 so the managed/native pair matches (M3 ubuntu CI finding). -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageVersion Include="HarfBuzzSharp" Version="8.3.1.5" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5" />
  </ItemGroup>

  <!-- Pinned at M10. Velopack 1.2.0 is the packaging/auto-update tool PLAN.md §1 locks in; the
       `vpk` CLI used by the release workflow is the same version (kept in step deliberately —
       the CLI writes the release metadata the runtime library reads). The Windows registry API the
       .tboard association needs is already in the net10.0 framework reference — a
       Microsoft.Win32.Registry package reference is rejected by NU1510 as redundant. -->
  <ItemGroup>
    <PackageVersion Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
