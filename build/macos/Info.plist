<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS bundle description (docs/M10-spec.md §3). CFBundleDocumentTypes plus the exported UTI
  are the ONLY way Launch Services learns that a .tboard file belongs to TrestleBoard — macOS has
  no equivalent of the Windows registry keys or the Linux .desktop file that the app writes for
  itself, so the association has to be declared here, inside the bundle, before it ships.
  __VERSION__ is substituted by build/macos/make-app-bundle.sh.
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>TrestleBoard</string>
  <key>CFBundleDisplayName</key>
  <string>TrestleBoard</string>
  <key>CFBundleIdentifier</key>
  <string>com.indianlandlodge414.trestleboard</string>
  <key>CFBundleExecutable</key>
  <string>TrestleBoard.App</string>
  <key>CFBundleIconFile</key>
  <string>trestleboard</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleVersion</key>
  <string>__VERSION__</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>Indian Land Masonic Lodge 414</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>TrestleBoard newsletter</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>tboard</string>
      </array>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.indianlandlodge414.trestleboard.newsletter</string>
      </array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.indianlandlodge414.trestleboard.newsletter</string>
      <key>UTTypeDescription</key>
      <string>TrestleBoard newsletter</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.zip-archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>tboard</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/x-tboard</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
